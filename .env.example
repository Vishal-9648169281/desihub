# ---- Django ----
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Set to True only once TLS is actually terminated in front of this app (real domain + cert).
# Leave False for a plain-HTTP deploy, otherwise session cookies break Django admin login.
DJANGO_USE_HTTPS=False

# ---- PostgreSQL ----
POSTGRES_DB=desihub
POSTGRES_USER=desihub
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.com

# ---- Uploads ----
MAX_VIDEO_UPLOAD_SIZE_MB=2048

# ---- Frontend ----
VITE_API_BASE_URL=/api
